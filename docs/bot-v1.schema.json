{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:commonroom:bot-api:v1",
  "title": "CommonRoom Bot API v1 — frozen",
  "description": "Validate the named definition for an endpoint or socket direction. UTF-8 byte limits and authorization are additionally checked by the server.",
  "definitions": {
    "IdempotencyKey": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},
    "Error": {"type": "object","properties": {"code": {"enum": ["invalid_request","unauthorized","forbidden","not_found","method_not_allowed","conflict","idempotency_conflict","message_gone","payload_too_large","rate_limited","idempotency_capacity","runtime_rejected","unavailable"]},"message": {"type": "string"},"retryable": {"type": "boolean"}},"required": ["code","message","retryable"],"additionalProperties": false},
    "ErrorResponse": {"type": "object","properties": {"error": {"$ref": "#/definitions/Error"}},"required": ["error"],"additionalProperties": false},
    "Ok": {"type": "object","properties": {"ok": {"const": true}},"required": ["ok"],"additionalProperties": false},
    "Permissions": {"type": "object","properties": {"send": {"type": "boolean"},"reply": {"type": "boolean"},"react": {"type": "boolean"}},"required": ["send","reply","react"],"additionalProperties": false},
    "Unread": {"type": "object","properties": {"count": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"first": {"anyOf": [{"type": "integer","minimum": 0,"maximum": 9007199254740991},{"type": "null"}]},"through": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"oldest": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["count","first","through","oldest","revision"],"additionalProperties": false},
    "Conversation": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"view": {"type": "string"},"permissions": {"$ref": "#/definitions/Permissions"},"members": {"type": "array","items": {"type": "string"}},"unread": {"$ref": "#/definitions/Unread"}},"required": ["id","view","permissions","members","unread"],"additionalProperties": false},
    "Snapshot": {"type": "object","properties": {"kind": {"const": "snapshot"},"account": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"username": {"type": "string"}},"required": ["id","username"],"additionalProperties": false},"conversations": {"type": "array","items": {"$ref": "#/definitions/Conversation"}}},"required": ["kind","account","conversations"],"additionalProperties": false},
    "Reply": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"from": {"type": "string"},"text": {"type": "string","maxLength": 160}},"required": ["id","from","text"],"additionalProperties": false},
    "Message": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"from": {"type": "string"},"author_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"text": {"type": "string","minLength": 1,"maxLength": 4000},"markdown": {"type": "boolean"},"edited": {"type": "boolean"},"time": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"sequence": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"reply": {"anyOf": [{"$ref": "#/definitions/Reply"},{"type": "null"}]},"mentions": {"type": "array","items": {"type": "string"}},"reactions": {"type": "object","maxProperties": 32,"additionalProperties": {"type": "array","items": {"type": "string"}}}},"required": ["id","from","author_id","text","markdown","edited","time","sequence","reply","mentions","reactions"],"additionalProperties": false},
    "MessageRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"text": {"type": "string","minLength": 1,"maxLength": 4000},"reply_to": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]},"markdown": {"type": "boolean","default": false}},"required": ["conversation_id","text"],"additionalProperties": false},
    "SendResponse": {"type": "object","properties": {"message": {"$ref": "#/definitions/Message"},"replayed": {"type": "boolean"}},"required": ["message","replayed"],"additionalProperties": false},
    "HistoryQuery": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"start": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"end": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"before": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"after": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"around": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"limit": {"type": "integer","minimum": 1,"maximum": 100}},"required": ["conversation_id"],"additionalProperties": false},
    "HistoryResponse": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"messages": {"type": "array","items": {"$ref": "#/definitions/Message"},"maxItems": 100},"revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"has_before": {"type": "boolean"},"has_after": {"type": "boolean"}},"required": ["conversation_id","messages","revision","has_before","has_after"],"additionalProperties": false},
    "ReadRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"through": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["conversation_id","through"],"additionalProperties": false},
    "ReactionRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"message_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"reaction": {"$ref": "#/definitions/Reaction"},"active": {"type": "boolean"}},"required": ["conversation_id","message_id","reaction","active"],"additionalProperties": false},
    "ConversationUpdate": {"type": "object","properties": {"kind": {"const": "conversation"},"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"}},"required": ["kind","conversation_id"],"additionalProperties": false},
    "ConfigReady": {"type": "object","properties": {"kind": {"const": "config_ready"}},"required": ["kind"],"additionalProperties": false},
    "ConfigRequest": {"type": "object","properties": {"kind": {"const": "config_request"},"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"operation": {"enum": ["set","fetch"]},"key": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 64,"pattern": "^[A-Za-z0-9._-]+$"},{"type": "null"}]},"value": {"anyOf": [{"type": "string","maxLength": 4096},{"type": "null"}]}},"required": ["kind","id","operation","key","value"],"additionalProperties": false},
    "ConfigResponse": {"type": "object","properties": {"kind": {"const": "config_response"},"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"values": {"anyOf": [{"type": "object","maxProperties": 128,"propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,64}$"},"additionalProperties": {"type": "string","maxLength": 4096}},{"type": "null"}]},"error": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 1024},{"type": "null"}]}},"required": ["kind","id"],"additionalProperties": false,"oneOf": [{"required": ["values"],"properties": {"values": {"type": "object"},"error": {"type": "null"}}},{"required": ["error"],"properties": {"error": {"type": "string"},"values": {"type": "null"}}}]},
    "ConfigAck": {"type": "object","properties": {"kind": {"const": "config_ack"},"id": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]}},"required": ["kind","id"],"additionalProperties": false},
    "SocketError": {"type": "object","properties": {"kind": {"const": "error"},"id": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]},"error": {"$ref": "#/definitions/Error"}},"required": ["kind","id","error"],"additionalProperties": false},
    "ServerFrame": {"oneOf": [{"$ref": "#/definitions/Snapshot"},{"$ref": "#/definitions/ConversationUpdate"},{"$ref": "#/definitions/ConfigRequest"},{"$ref": "#/definitions/ConfigAck"},{"$ref": "#/definitions/SocketError"}]},
    "ClientFrame": {"oneOf": [{"$ref": "#/definitions/ConfigReady"},{"$ref": "#/definitions/ConfigResponse"}]},
    "Reaction": {"type": "string","minLength": 1,"maxLength": 128,"allOf": [{"pattern": "^\\S(?:[\\s\\S]*\\S)?$"},{"not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"}}]}
  }
}
