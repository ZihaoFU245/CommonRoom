{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:commonroom:bot-api:v1",
  "title": "CommonRoom Bot API v1",
  "description": "Validate the named definition for an endpoint or socket direction. UTF-8 byte limits and authorization are additionally checked by the server.",
  "definitions": {
    "IdempotencyKey": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},
    "Error": {"type": "object","properties": {"code": {"enum": ["invalid_request","unauthorized","forbidden","not_found","method_not_allowed","conflict","idempotency_conflict","message_gone","payload_too_large","rate_limited","idempotency_capacity","runtime_rejected","unavailable"]},"message": {"type": "string"},"retryable": {"type": "boolean"}},"required": ["code","message","retryable"],"additionalProperties": false},
    "ErrorResponse": {"type": "object","properties": {"error": {"$ref": "#/definitions/Error"}},"required": ["error"],"additionalProperties": false},
    "Ok": {"type": "object","properties": {"ok": {"const": true}},"required": ["ok"],"additionalProperties": false},
    "Permissions": {"type": "object","properties": {"send": {"type": "boolean"},"reply": {"type": "boolean"},"react": {"type": "boolean"}},"required": ["send","reply","react"],"additionalProperties": false},
    "Unread": {"type": "object","properties": {"count": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"first": {"anyOf": [{"type": "integer","minimum": 0,"maximum": 9007199254740991},{"type": "null"}]},"through": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"oldest": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["count","first","through","oldest","revision"],"additionalProperties": false},
    "Conversation": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"view": {"type": "string"},"permissions": {"$ref": "#/definitions/Permissions"},"members": {"type": "array","items": {"type": "string"}},"unread": {"anyOf": [{"$ref": "#/definitions/Unread"},{"type": "null"}]},"content_revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["id","view","permissions","members","unread","content_revision"],"additionalProperties": false},
    "Snapshot": {"type": "object","properties": {"kind": {"const": "snapshot"},"account": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"username": {"type": "string"}},"required": ["id","username"],"additionalProperties": false},"conversations": {"type": "array","items": {"$ref": "#/definitions/Conversation"}},"credential": {"$ref": "#/definitions/Credential"}},"required": ["kind","account","conversations","credential"],"additionalProperties": false},
    "Reply": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"from": {"type": "string"},"text": {"type": "string","maxLength": 160}},"required": ["id","from","text"],"additionalProperties": false},
    "Message": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"from": {"type": "string"},"author_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"text": {"type": "string","minLength": 1,"maxLength": 4000},"markdown": {"type": "boolean"},"edited": {"type": "boolean"},"time": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"sequence": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"reply": {"anyOf": [{"$ref": "#/definitions/Reply"},{"type": "null"}]},"mentions": {"type": "array","items": {"type": "string"}},"reactions": {"type": "object","maxProperties": 32,"additionalProperties": {"type": "array","items": {"type": "string"}}}},"required": ["id","from","author_id","text","markdown","edited","time","sequence","reply","mentions","reactions"],"additionalProperties": false},
    "MessageRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"text": {"type": "string","minLength": 1,"maxLength": 4000},"reply_to": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]},"markdown": {"type": "boolean","default": true}},"required": ["conversation_id","text"],"additionalProperties": false},
    "SendResponse": {"type": "object","properties": {"message": {"$ref": "#/definitions/Message"},"replayed": {"type": "boolean"}},"required": ["message","replayed"],"additionalProperties": false},
    "HistoryQuery": {"type":"object","properties":{"conversation_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"start":{"type":"integer","minimum":0,"maximum":9007199254740991},"end":{"type":"integer","minimum":0,"maximum":9007199254740991},"before":{"type":"integer","minimum":0,"maximum":9007199254740991},"after":{"type":"integer","minimum":0,"maximum":9007199254740991},"around":{"type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"type":"integer","minimum":1,"maximum":100},"content_revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"message_id":{"$ref":"#/definitions/IdempotencyKey"}},"required":["conversation_id"],"additionalProperties":false},
    "HistoryResponse": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"messages": {"type": "array","items": {"$ref": "#/definitions/Message"},"maxItems": 100},"has_before": {"type": "boolean"},"has_after": {"type": "boolean"},"content_revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["conversation_id","messages","has_before","has_after","content_revision"],"additionalProperties": false},
    "ReadRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"through": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"acknowledge_shared_unread": {"const": true}},"required": ["conversation_id","through","acknowledge_shared_unread"],"additionalProperties": false},
    "ReactionRequest": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"message_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"reaction": {"$ref": "#/definitions/Reaction"},"active": {"type": "boolean"}},"required": ["conversation_id","message_id","reaction","active"],"additionalProperties": false},
    "ConversationUpdate": {"type": "object","properties": {"kind": {"const": "conversation"},"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"content_revision": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["kind","conversation_id","content_revision"],"additionalProperties": false},
    "ConfigAck": {"type": "object","properties": {"kind": {"const": "config_ack"},"id": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]}},"required": ["kind","id"],"additionalProperties": false},
    "SocketError": {"type": "object","properties": {"kind": {"const": "error"},"id": {"anyOf": [{"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},{"type": "null"}]},"error": {"$ref": "#/definitions/Error"}},"required": ["kind","id","error"],"additionalProperties": false},
    "ServerFrame": {"oneOf":[{"$ref":"#/definitions/Snapshot"},{"$ref":"#/definitions/ConversationUpdate"},{"$ref":"#/definitions/ConfigAck"},{"$ref":"#/definitions/SocketError"},{"$ref":"#/definitions/Activity"},{"$ref":"#/definitions/Presence"},{"$ref":"#/definitions/CommandsRequest"}]},
    "ClientFrame": {"oneOf":[{"$ref":"#/definitions/ActivityRequest"},{"$ref":"#/definitions/CommandsReady"},{"$ref":"#/definitions/CommandsChanged"},{"$ref":"#/definitions/CommandsResponse"}]},
    "Reaction": {"type": "string","minLength": 1,"maxLength": 128,"allOf": [{"pattern": "^\\S(?:[\\s\\S]*\\S)?$"},{"not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"}}]},
    "Credential": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"expires": {"anyOf": [{"type": "integer","minimum": 0,"maximum": 9007199254740991},{"type": "null"}]},"conversations": {"anyOf": [{"type": "array","items": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"uniqueItems": true},{"type": "null"}]},"operations": {"anyOf": [{"type": "array","items": {"type": "string"},"uniqueItems": true},{"type": "null"}]}},"required": ["id","expires","conversations","operations"],"additionalProperties": false},
    "CredentialRequest": {"type": "object","properties": {"label": {"type": "string","minLength": 1,"maxLength": 32},"expires": {"type": "integer","minimum": 0,"maximum": 9007199254740991},"conversations": {"type": "array","items": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"uniqueItems": true},"operations": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"enum": ["read","send","react","read_ack","activity","config","commands"]}}},"required": ["label","expires","conversations","operations"],"additionalProperties": false},
    "CredentialResponse": {"type": "object","properties": {"id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"token": {"type": "string","pattern": "^bot_[a-f0-9]{64}$"},"expires": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["id","token","expires"],"additionalProperties": false},
    "ConversationRequest": {"oneOf": [{"type": "object","properties": {"kind": {"const": "room"},"name": {"type": "string","minLength": 1,"maxLength": 32}},"required": ["kind","name"],"additionalProperties": false},{"type": "object","properties": {"kind": {"const": "direct"},"username": {"type": "string","minLength": 1,"maxLength": 32}},"required": ["kind","username"],"additionalProperties": false}]},
    "ConversationResponse": {"type": "object","properties": {"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"}},"required": ["conversation_id"],"additionalProperties": false},
    "ActivityRequest": {"type": "object","properties": {"kind": {"const": "activity"},"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"state": {"enum": ["working","idle"]}},"required": ["kind","conversation_id","state"],"additionalProperties": false},
    "Activity": {"type": "object","properties": {"kind": {"const": "activity"},"conversation_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"state": {"enum": ["working","idle"]},"account_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},"expires": {"type": "integer","minimum": 0,"maximum": 9007199254740991}},"required": ["kind","conversation_id","state","account_id","expires"],"additionalProperties": false},
    "BotCommand": {"type":"object","properties":{"name":{"type":"string","pattern":"^/[a-z0-9_-]{1,32}$"},"usage":{"type":"string","minLength":1,"maxLength":256},"description":{"type":"string","minLength":1,"maxLength":512},"operator_only":{"type":"boolean","default":false},"subcommands":{"type":"array","maxItems":64,"items":{"$ref":"#/definitions/BotSubcommand"}}},"required":["name","usage","description"],"additionalProperties":false},
    "BotSubcommand": {"type":"object","properties":{"name":{"type":"string","pattern":"^[a-z0-9_-]{1,32}$"},"usage":{"type":"string","minLength":1,"maxLength":256},"description":{"type":"string","minLength":1,"maxLength":512},"operator_only":{"type":"boolean","default":false},"subcommands":{"type":"array","maxItems":64,"items":{"$ref":"#/definitions/BotSubcommandLeaf"}}},"required":["name","usage","description"],"additionalProperties":false},
    "BotSubcommandLeaf": {"type":"object","properties":{"name":{"type":"string","pattern":"^[a-z0-9_-]{1,32}$"},"usage":{"type":"string","minLength":1,"maxLength":256},"description":{"type":"string","minLength":1,"maxLength":512},"operator_only":{"type":"boolean","default":false},"subcommands":{"type":"array","maxItems":0}},"required":["name","usage","description"],"additionalProperties":false},
    "ServerCommandsQuery": {"type":"object","properties":{"conversation_id":{"$ref":"#/definitions/IdempotencyKey"}},"required":["conversation_id"],"additionalProperties":false},
    "ServerCommandsResponse": {"type":"object","properties":{"conversation_id":{"$ref":"#/definitions/IdempotencyKey"},"commands":{"type":"array","maxItems":64,"items":{"$ref":"#/definitions/BotCommand"}}},"required":["conversation_id","commands"],"additionalProperties":false},
    "ServerCommandRequest": {"type":"object","properties":{"conversation_id":{"$ref":"#/definitions/IdempotencyKey"},"command":{"type":"string","minLength":1,"maxLength":4100}},"required":["conversation_id","command"],"additionalProperties":false},
    "ServerCommandResponse": {"type":"object","properties":{"result":{"type":"string"},"replayed":{"type":"boolean"},"expires":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["result","replayed","expires"],"additionalProperties":false},
    "MessageContextQuery": {"type":"object","properties":{"conversation_id":{"$ref":"#/definitions/IdempotencyKey"},"message_id":{"$ref":"#/definitions/IdempotencyKey"}},"required":["conversation_id","message_id"],"additionalProperties":false},
    "MessageContextResponse": {"type":"object","properties":{"author":{"type":"object","properties":{"id":{"type":"string"},"username":{"type":"string"},"groups":{"type":"array","items":{"type":"string"}},"permissions":{"type":["array","null"],"items":{"type":"string"}}},"required":["id","username","groups","permissions"],"additionalProperties":false},"bot":{"type":"object","properties":{"id":{"type":"string"},"groups":{"type":"array","items":{"type":"string"}},"owner_id":{"type":["string","null"]},"owner":{"type":["string","null"]}},"required":["id","groups","owner_id","owner"],"additionalProperties":false}},"required":["author","bot"],"additionalProperties":false},
    "CommandsReady": {"type":"object","properties":{"kind":{"const":"commands_ready"}},"required":["kind"],"additionalProperties":false},
    "CommandsChanged": {"type":"object","properties":{"kind":{"const":"commands_changed"}},"required":["kind"],"additionalProperties":false},
    "CommandsRequest": {"type":"object","properties":{"kind":{"const":"commands_request"},"id":{"$ref":"#/definitions/IdempotencyKey"},"conversation_id":{"$ref":"#/definitions/IdempotencyKey"}},"required":["kind","id","conversation_id"],"additionalProperties":false},
    "CommandsResponse": {"type":"object","properties":{"kind":{"const":"commands_response"},"id":{"$ref":"#/definitions/IdempotencyKey"},"commands":{"type":"array","maxItems":64,"items":{"$ref":"#/definitions/BotCommand"}}},"required":["kind","id","commands"],"additionalProperties":false},
    "CommandReceiptResponse": {"oneOf":[{"type":"object","properties":{"state":{"const":"not_found"}},"required":["state"],"additionalProperties":false},{"type":"object","properties":{"state":{"const":"succeeded"},"result":{"type":"string"},"error":{"type":"null"},"created":{"type":"integer","minimum":0},"expires":{"type":"integer","minimum":0}},"required":["state","result","error","created","expires"],"additionalProperties":false},{"type":"object","properties":{"state":{"const":"failed"},"result":{"type":"null"},"error":{"$ref":"#/definitions/Error"},"created":{"type":"integer","minimum":0},"expires":{"type":"integer","minimum":0}},"required":["state","result","error","created","expires"],"additionalProperties":false}]},
    "Presence": {"type": "object","properties": {"kind": {"const": "presence"},"online": {"type": "array","items": {"type": "string"}}},"required": ["kind","online"],"additionalProperties": false}
  }
}
