{
  "name": "chatroom-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:integration": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.js",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
