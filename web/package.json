{
  "name": "chatroom-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:integration": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.js",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:exports && pnpm format:check",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.mjs tsconfig.json package.json stylelint.config.mjs README.md index.html",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.mjs tsconfig.json package.json stylelint.config.mjs README.md index.html",
    "test:browser": "node scripts/browser-test.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:exports": "knip --include exports"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@mdit/plugin-tex": "^1.1.3",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "parse5": "^8.0.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "6.15.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
