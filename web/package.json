{
  "name": "chatroom-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:integration": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
