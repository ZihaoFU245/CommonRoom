{
  "tasks": {
    "start": "deno run -P src/launch.ts",
    "dev": "deno run -P src/launch.ts --dev",
    "config": "deno run -P src/config-cli.ts",
    "test": "deno test --unstable-kv -A --no-check test/*.test.ts",
    "check": "node ../web/node_modules/@typescript/native/bin/tsc -p tsconfig.json"
  },
  "permissions": {
    "default": {
      "read": ["./data"],
      "write": ["./data"],
      "net": true,
      "env": true,
      "run": ["deno"]
    },
    "with-shell": {
      "read": ["./data"],
      "write": ["./data"],
      "net": true,
      "env": true,
      "run": true
    }
  }
}
