{
  "tasks": {
    "start": "deno run --unstable-kv -P src/main.ts",
    "dev": "deno run --unstable-kv -P --watch=src --no-clear-screen src/main.ts",
    "config": "deno run -P src/config-cli.ts",
    "test": "deno test --unstable-kv -A --no-check test/*.test.ts",
    "check": "node ../web/node_modules/@typescript/native/bin/tsc -p tsconfig.json"
  },
  "permissions": {
    "default": {
      "read": ["./data"],
      "write": ["./data"],
      "net": true,
      "env": true,
      "run": ["deno"]
    }
  }
}
